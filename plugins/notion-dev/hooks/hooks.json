{
  "description": "notion-dev: keep a --non-interactive run from ending its turn mid-run.",
  "hooks": {
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/stop-guard.sh\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
